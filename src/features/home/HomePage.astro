---
import Navbar from './components/layout/Navbar'
import Hero from './components/layout/Hero.astro'
import SectionLayout from './components/layout/SectionLayout.astro'
import { ABOUT_ME } from '@config/about-me'
import { FEATURE_PROJECTS } from '@config/projects'
import { ArrowRight, ExternalLink } from 'lucide-preact'
import { NAVIGATION_PAGE } from '@config/navigation'
import ContactButton from './components/ContactButton'
---

<Navbar client:only />

<main class='mt-17 md:mt-13'>
  <Hero />

  <SectionLayout
    label='About'
    id='about'
    background='bg-background'
    classContainer='grid lg:grid-cols-[1.5fr_41px_1fr] gap-4'
  >
    <section>
      <h2 class='font-bold'>Who I am</h2>
      <p>{ABOUT_ME.description}</p>
      <div class='py-4 flex flex-wrap gap-2 max-w-160'>
        {
          ABOUT_ME.technologies.map((el) => (
            <div class='flex items-center gap-2 border border-divider py-1 px-2 rounded bg-surface-elevated'>
              <el.icon /> {el.label}
            </div>
          ))
        }
      </div>
    </section>
    <hr class='block border-0 lg:w-px w-full h-px lg:h-full bg-divider' />
    <section class='flex flex-col gap-4'>
      {
        ABOUT_ME.general.map((el) => (
          <div class='flex items-star gap-4'>
            <el.icon size={30} className='text-accent' />
            <div>
              <h3 class='text-lg font-semibold'>{el.label}</h3>
              <p>{el.text}</p>
            </div>
          </div>
        ))
      }
    </section>
  </SectionLayout>

  <SectionLayout label='Projects' id='projects' background='bg-surface' classContainer='grid gap-6'>
    <div class='flex justify-between items-end'>
      <h2>Featured Projects</h2>
      <a href={NAVIGATION_PAGE.projects} class='flex items-center gap-2 text-accent'
        >View all projects <ArrowRight size={18} />
      </a>
    </div>
    <div class='grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-4'>
      {
        FEATURE_PROJECTS.map(({ image, description, title, technologies, url, ariaLabel }) => (
          <a
            href={url}
            target='_blank'
            aria-label={ariaLabel}
            title={ariaLabel}
            class='flex flex-col gap-3 bg-surface-elevated overflow-hidden rounded-xl shadow-lg border border-divider relative hover:scale-102 active:scale-98 group transition duration-200'
          >
            <picture class='h-38 w-auto overflow-hidden object-cover'>
              <img src={image.src} alt={image.alt} class='w-full h-full' />
            </picture>
            <div class='grid gap-3 px-4 pb-4'>
              <h3 class='font-semibold text-2xl'>{title}</h3>
              <p>{description}</p>
              <div>
                {technologies.map((el) => (
                  <img src={el.img} alt={el.alt} class='inline-block mr-3 mb-3' />
                ))}
              </div>
              <ExternalLink className='absolute bottom-4 right-4 z-10 opacity-0 scale-75 pointer-events-none transition-all duration-300 ease-out group-hover:opacity-100 group-hover:scale-100  group-hover:pointer-events-auto' />
            </div>
          </a>
        ))
      }
    </div>
  </SectionLayout>

  <SectionLayout label='Contact' id='contact' background='bg-background' classContainer='grid gap-6'>
    <section class='grid gap-4'>
      <h2>Let's work together</h2>
      <p>Have an opportunity or a project in mind? I'd love to hear from you.</p>
      <ContactButton />
    </section>
  </SectionLayout>
</main>
