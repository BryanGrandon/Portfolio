---
import { ArrowRight, Download } from 'lucide-preact'
import { cn } from '@shared/lib/cn'
import { HERO } from '@config/hero'
import Image from '../Image.astro'
const { name, lastName, description, links, role, image } = HERO
---

<header id='home' class='flex items-center min-h-100 border-b border-divider bg-surface px-4 py-10'>
  <article class='max-width grid md:grid-cols-2 gap-8'>
    <section class='flex flex-col gap-4 order-2 md:order-1'>
      <div>
        <span class='text-muted hero_label'>Hi, I'm</span>
        <h1 class='font-bold'>{name} <span class='text-accent'>{lastName}</span></h1>
        <span class='text-muted hero_label'>{role}</span>
      </div>
      <p class='text-lg'>{description}</p>
      <div class='flex gap-4'>
        <a
          href={links.projects}
          class={cn(
            'button',
            'shadow shadow-brand transition-colors duration-350 bg-brand/80 hover:bg-accent text-white group',
          )}
        >
          View My Projects <ArrowRight
            size={20}
            className='transition-transform duration-300 group-hover:translate-x-1'
          />
        </a>
        <a
          href={links.download}
          class={cn(
            'button group',
            'shadow border border-divider transition-colors duration-350 bg-surface hover:bg-surface-elevated',
          )}
        >
          Download CV <Download size={20} className='transition-transform duration-300 group-hover:-rotate-6' />
        </a>
      </div>
    </section>

    <Image src={image.src} alt={image.alt} />
  </article>
</header>
