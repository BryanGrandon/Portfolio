---
import Badge from '../Badge.astro'

interface Props {
  id: string
  label: string
  background: string
  classContainer: string
}

const { id, background, classContainer, label } = Astro.props
---

<article id={id} class={`min-h-110 grid items-center px-4 py-10 ${background} border-b border-divider`}>
  <article class='max-width grid gap-2'>
    <Badge title={label} />
    <section class={classContainer}>
      <slot />
    </section>
  </article>
</article>
