---
import Title from '../../core/ui/Title.astro'
import ContactInfo from '../ui/ContactInfo.astro'
import { IconClock, IconEmail, IconTimeZone } from '../../core/icons/IconContactMe'
import { WEBSITE_CONTACT } from '../../../utils/constants/website'
import { ArrowRight, Mail } from 'lucide-preact'
const { title, subtitle, paragraph } = WEBSITE_CONTACT
---

<article id='contact' class='pt-12 pb-8'>
  <article class='flex flex-col gap-8 max-w-350 mx-auto py-8 px-4'>
    <article class='col-span-2'>
      <Title title={title} subtitle={subtitle} />
      <section>
        {paragraph.map((text) => <p class='prose dark:prose-invert'>{text}</p>)}
      </section>
      <a
        href='mailto:tu@email.com'
        class='group inline-flex items-center justify-center gap-3
        rounded-full px-6 py-3
        bg-linear-to-r from-indigo-500 to-blue-500
        font-medium text-white
        shadow-lg shadow-indigo-500/20
        transition-all duration-300
        hover:from-indigo-600 hover:to-blue-600
        hover:shadow-xl hover:shadow-indigo-500/30
        focus-visible:outline-none
        focus-visible:ring-2 focus-visible:ring-indigo-400
        focus-visible:ring-offset-2
        focus-visible:ring-offset-slate-950
        active:scale-95'
      >
        <Mail size={20} className='transition-transform duration-300 group-hover:-rotate-6' />

        <span>Get in touch</span>

        <ArrowRight size={20} className='transition-transform duration-300 group-hover:translate-x-1' />
      </a>
    </article>
    <article class='flex gap-4 flex-wrap'>
      <ContactInfo title='Email' text='bryan.grandon.c@gmail.com'><IconEmail slot='icon' /></ContactInfo>
      <ContactInfo title='Hours of operation' text='9:00 a.m. - 18:00 p.m'><IconClock slot='icon' /></ContactInfo>
      <ContactInfo title='Time Zone' text='GMT-3'><IconTimeZone slot='icon' /></ContactInfo>
    </article>
  </article>
</article>
